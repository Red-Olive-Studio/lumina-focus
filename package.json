{
  "name": "lumina",
  "productName": "Lumina",
  "version": "0.8.1",
  "private": true,
  "description": "A calm little side app: focus timer, what's now and next, and gentle reminders for people who work at a PC all day.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "npx --yes serve web",
    "test": "node --test test/logic.test.mjs",
    "dist": "electron-builder --win nsis",
    "test-mode": "electron . --test"
  },
  "build": {
    "appId": "studio.redolive.lumina",
    "productName": "Lumina",
    "files": [
      "main.js",
      "preload.js",
      "web/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "web/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "Lumina-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8"
  }
}
